# Terraform working directories
**/.terraform/*

# Terraform state (should only ever live in the GCS backend)
*.tfstate
*.tfstate.*

# Saved plans (can contain sensitive values)
*.tfplan
tfplan

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files: commit terraform.tfvars (non-secret config only).
# Anything named secrets.* stays local.
secrets.auto.tfvars
secrets.auto.tfvars.json

# Crash logs
crash.log
crash.*.log

# Environment files
.env
.env.*
!.env.example

# Credentials, in case a key ever lands in the repo by accident
*.pem
*.p12
*-key.json
credentials*.json

# macOS
.DS_Store