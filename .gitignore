cat > .gitignore <<'EOF'
# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
!*.example.tfvars

# Crash logs
crash.log
crash.*.log

# Environment files
.env
.env.*

# macOS files
.DS_Store
EOF